# Generate a new key: node scripts/setup.mjs
INGEST_API_KEY=
DEVICE_ID=outdoor-esp32-v5
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/weather.sqlite
TOWN=Shelburne
REGION=Ontario
TIME_ZONE=America/Toronto
# The exact public HTTPS origin, once a hostname is configured.
PUBLIC_ORIGIN=
# Enable only when a trusted reverse proxy is the ONLY client of this server.
# That proxy must overwrite X-Forwarded-For with the visitor's IP address.
TRUST_PROXY=false
RETENTION_DAYS=365
# Set above the planned upload interval if the battery firmware reports less often.
STALE_AFTER_SECONDS=300
# Leave blank until measured; the station reports raw rain tip counts.
RAIN_MM_PER_TIP=
# Physical rain/wind meters are still being built; ignore these inputs for now.
WIND_ENABLED=false
RAIN_ENABLED=false
# Provisional town elevation. Replace with the sensor's measured elevation.
STATION_ELEVATION_M=500
ELEVATION_VERIFIED=false
# Sensor offset is separate from elevation correction; do not force 1013.25 hPa.
PRESSURE_OFFSET_HPA=0
